# Copy to .env (never commit .env). Values here are PUBLIC configuration only.
# development | staging | production. EAS build profiles set this for you.
APP_ENV=development
# Backend origin (no trailing /api/v1). Non-development builds MUST use https://
EXPO_PUBLIC_API_URL=http://localhost:8000
# Optional. Defaults to the API origin with ws(s):// + /ws/v1/. Non-development builds MUST use wss://
EXPO_PUBLIC_WS_URL=
# Optional. Sentry is disabled when empty.
EXPO_PUBLIC_SENTRY_DSN=
