# ─── Server ─────────────────────────────────────────────────────────────
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Optional. Leave empty and the server generates one on first start (saved as
# data/jwt-secret next to the database). To set your own (>= 32 chars):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=30d

# SQLite database file (created automatically)
DATABASE_PATH=./data/najik.db

# Comma-separated list of extra allowed browser origins.
# The Android app origins (https://localhost, http://localhost, capacitor://localhost)
# are always allowed. Add your web dev server / domain here.
CORS_ORIGINS=http://localhost:5173

# ─── WebRTC / ICE ───────────────────────────────────────────────────────
# Comma-separated STUN URLs
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# TURN is strongly recommended for calls across mobile networks / strict NATs.
# Comma-separated TURN URLs, e.g. turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
TURN_URLS=
# Option A (recommended, coturn "use-auth-secret"): short-lived HMAC credentials
TURN_SECRET=
TURN_TTL_SECONDS=3600
# Option B: static credentials (used when TURN_SECRET is empty)
TURN_USERNAME=
TURN_CREDENTIAL=

# How long an unanswered call rings before it is marked as missed (seconds)
CALL_RING_TIMEOUT_SECONDS=40

# ─── Push notifications (Firebase Cloud Messaging) ─────────────────────
# Rings the app for incoming calls even when it is closed. Use ONE of:
#   a path to the service-account JSON (Firebase console → Project settings →
#   Service accounts → Generate new private key) …
FIREBASE_SERVICE_ACCOUNT_PATH=
#   … or the same JSON, base64-encoded (convenient for containers / PaaS)
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Development only: print pushes instead of sending them
FCM_LOG_ONLY=0
