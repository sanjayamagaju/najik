# Najik backend configuration. Copy to `.env` for local development (only read when
# DJANGO_ENV=development). In staging/production pass these as real environment variables
# (see deploy/.env.example). Never commit real values.

# --- Core ------------------------------------------------------------------------------
# development | staging | production   (pytest uses config.settings.test automatically)
DJANGO_ENV=development
# >= 50 random chars in staging/production: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# Optional separate HMAC key for access JWTs (defaults to SECRET_KEY). Rotating it logs
# every device out of its current access token (they refresh transparently).
JWT_SIGNING_KEY=
DEBUG=true
# Comma-separated host names served by the API (required outside development).
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
# Release identifier for logs/Sentry (the Docker image sets it at build time).
RELEASE=dev

# --- Data stores -----------------------------------------------------------------------
# Empty -> SQLite file db.sqlite3 (development only). Production requires PostgreSQL.
# DATABASE_URL=
# DATABASE_URL=postgres://najik:najik@localhost:5432/najik
# psycopg3 connection pool per worker process (PostgreSQL only).
DB_POOL=true
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT_SEC=10
# Empty -> in-process fakeredis + in-memory channel layer + eager Celery (single process
# development only). Production requires Redis.
REDIS_URL=
# REDIS_URL=redis://localhost:6379/0
# Optional overrides (default to REDIS_URL).
# CELERY_BROKER_URL=
# CHANNEL_LAYER_REDIS_URL=
REDIS_KEY_PREFIX=nj:
# Run Celery tasks inline (defaults to true only when REDIS_URL is empty).
# CELERY_TASK_ALWAYS_EAGER=

# --- Tokens ----------------------------------------------------------------------------
ACCESS_TOKEN_LIFETIME_SEC=900
REFRESH_TOKEN_LIFETIME_SEC=2592000

# --- Realtime / calls ------------------------------------------------------------------
WS_HEARTBEAT_SEC=25
WS_AUTH_TIMEOUT_SEC=10
# Close a socket after this many rate-limited frames within 60 s (code 4008).
WS_ABUSE_CLOSE_THRESHOLD=20
CALL_RING_TIMEOUT_SEC=45
CALL_RECONNECT_GRACE_SEC=30
# Also enforce call deadlines with Celery countdown tasks (default: true when Redis is set).
# CALL_TIMERS_USE_CELERY=

# --- TURN / STUN (coturn with use-auth-secret) -----------------------------------------
# Shared secret; must equal coturn's static-auth-secret. Required outside development.
TURN_SECRET=
# Comma-separated. Example:
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
TURN_URLS=
# STUN_URLS=stun:turn.example.com:3478
STUN_URLS=
TURN_CREDENTIAL_TTL_SEC=3600

# --- Push ------------------------------------------------------------------------------
# true -> log push metadata instead of sending (default true in development).
PUSH_LOG_ONLY=true
# FCM HTTP v1: Firebase project id + service account (file path, or JSON/base64 JSON).
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=
FCM_CREDENTIALS_JSON=
# Android notification channel ids created by the app.
FCM_ANDROID_CHANNEL_MESSAGES=messages
FCM_ANDROID_CHANNEL_PINGS=pings
# APNs token auth (.p8 key). VoIP pushes use topic <APNS_BUNDLE_ID>.voip.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=
APNS_PRIVATE_KEY_FILE=
# Alternatively the PEM itself (literal "\n" sequences are accepted).
APNS_PRIVATE_KEY=
# true for development builds (api.sandbox.push.apple.com).
APNS_USE_SANDBOX=false
PUSH_HTTP_TIMEOUT_SEC=10

# --- Admin -----------------------------------------------------------------------------
# URL prefix of the Django admin; empty disables it (production default: disabled).
ADMIN_URL=admin/

# --- Proxy -----------------------------------------------------------------------------
# Number of trusted reverse proxies appending to X-Forwarded-For (production default 1).
TRUSTED_PROXY_COUNT=0
# Peers allowed to set proxy headers for uvicorn (gunicorn worker); "*" only on a private network.
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Production security (production/staging only) --------------------------------------
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=false
# CSRF_TRUSTED_ORIGINS=

# --- Observability ---------------------------------------------------------------------
LOG_LEVEL=INFO
# JSON logs (default false in development, true in staging/production).
LOG_JSON=false
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
# Serve Prometheus metrics at /metrics (block it at the proxy).
METRICS_ENABLED=true
# Set in containers so gunicorn/celery worker processes aggregate metrics.
# PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus
# Port of the Celery worker's metrics endpoint.
WORKER_METRICS_PORT=9808

# --- Gunicorn (container) --------------------------------------------------------------
WEB_CONCURRENCY=2
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_TIMEOUT=60
GUNICORN_GRACEFUL_TIMEOUT=30
CELERY_CONCURRENCY=4
CELERY_LOG_LEVEL=info
