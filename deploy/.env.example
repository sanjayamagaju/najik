# Production environment for deploy/docker-compose.yml. Copy to deploy/.env (chmod 600).
# Used both for compose interpolation (${...}) and as env_file for the backend containers.
# All backend variables are documented in backend/.env.example.

# --- Compose / infrastructure -----------------------------------------------------------
# Image to run (tag it with the git SHA for rollbacks), e.g. ghcr.io/acme/najik-backend:4f2c1ab
NAJIK_IMAGE=najik-backend:latest
RELEASE=2026.10.07-1
API_DOMAIN=api.example.com
TURN_DOMAIN=turn.example.com
ACME_EMAIL=ops@example.com
# Public IPv4 of the host (coturn advertises it in relay candidates).
TURN_EXTERNAL_IP=203.0.113.10
# Caddy's ACME issuer directory name (change if Caddy fell back to ZeroSSL:
# acme.zerossl.com-v2-dv90).
TURN_CERT_ISSUER=acme-v02.api.letsencrypt.org-directory

POSTGRES_USER=najik
POSTGRES_DB=najik
# Use URL-safe values (they are embedded in DATABASE_URL/REDIS_URL): openssl rand -hex 32
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me

# --- Django -----------------------------------------------------------------------------
DJANGO_ENV=production
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-at-least-50-random-characters
JWT_SIGNING_KEY=
ALLOWED_HOSTS=api.example.com
# Leave empty to disable the admin. Otherwise use an unguessable path ending in "/".
ADMIN_URL=
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
METRICS_ENABLED=true

# --- Calls ------------------------------------------------------------------------------
# openssl rand -hex 32  (shared with coturn via --static-auth-secret)
TURN_SECRET=change-me
TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
STUN_URLS=stun:turn.example.com:3478
TURN_CREDENTIAL_TTL_SEC=3600

# --- Push -------------------------------------------------------------------------------
PUSH_LOG_ONLY=false
FCM_PROJECT_ID=your-firebase-project
# Base64 of the service-account JSON (or mount a file and use FCM_CREDENTIALS_FILE).
FCM_CREDENTIALS_JSON=
APNS_TEAM_ID=ABCDE12345
APNS_KEY_ID=KEY1234567
APNS_BUNDLE_ID=com.example.najik
# Contents of the .p8 key with newlines written as \n (or mount it and use APNS_PRIVATE_KEY_FILE).
APNS_PRIVATE_KEY=
APNS_USE_SANDBOX=false

# --- Capacity ---------------------------------------------------------------------------
WEB_CONCURRENCY=4
DB_POOL_MAX_SIZE=10
CELERY_CONCURRENCY=4
