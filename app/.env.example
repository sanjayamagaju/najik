# URL of the Najik server the app connects to.
#  - Web development (npm run dev): leave empty — Vite proxies /api and /socket.io.
#  - Android APK: optional. When empty, the build uses this PC's LAN address
#    (http://<this-PC-IP>:4000) and prints it. Set it for a deployed server,
#    e.g. https://najik.example.com (put it in app/.env.production.local).
# The URL can also be changed at runtime from the login screen (⚙ Server).
VITE_SERVER_URL=

# Web dev only: where Vite proxies API/socket traffic.
DEV_PROXY_TARGET=http://localhost:4000
